# .htaccess - Portfolio Website
# Enable rewrite engine
RewriteEngine On

# Set base path - CHANGE THIS FOR YOUR DEPLOYMENT:
# - For subdirectory (localhost/Tamim/): RewriteBase /Tamim/
# - For root domain (traveleyebangla.com): RewriteBase /
RewriteBase /

# Force HTTPS (uncomment if you have SSL)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www or non-www (choose one)
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^(.*)$ https://example.com/$1 [L,R=301]

# Remove .php extension
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect trailing slashes (except for directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Handle project details: /project/project-slug -> project.php?slug=project-slug
RewriteRule ^project/([a-zA-Z0-9_-]+)/?$ project.php?slug=$1 [L,QSA]

# Handle blog listing: /blog/ -> blog.php
RewriteRule ^blog/?$ blog.php [L,QSA]

# Handle blog posts: /blog/post-slug -> blog.php?slug=post-slug
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog.php?slug=$1 [L,QSA]

# Handle blog category: /blog/category/category-slug -> blog.php?category=category-slug
RewriteRule ^blog/category/([a-zA-Z0-9_-]+)/?$ blog.php?category=$1 [L,QSA]

# Handle admin routes
RewriteRule ^admin/login/?$ admin/login.php [L,QSA]
RewriteRule ^admin/logout/?$ admin/logout.php [L,QSA]
RewriteRule ^admin/dashboard/?$ admin/dashboard.php [L,QSA]
RewriteRule ^admin/settings/?$ admin/settings/index.php [L,QSA]
RewriteRule ^admin/homepage/?$ admin/homepage/index.php [L,QSA]
RewriteRule ^admin/about/?$ admin/about/index.php [L,QSA]
RewriteRule ^admin/skills/?$ admin/skills/index.php [L,QSA]
RewriteRule ^admin/skills/create/?$ admin/skills/create.php [L,QSA]
RewriteRule ^admin/skills/edit/([0-9]+)/?$ admin/skills/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/services/?$ admin/services/index.php [L,QSA]
RewriteRule ^admin/services/create/?$ admin/services/create.php [L,QSA]
RewriteRule ^admin/services/edit/([0-9]+)/?$ admin/services/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/projects/?$ admin/projects/index.php [L,QSA]
RewriteRule ^admin/projects/create/?$ admin/projects/create.php [L,QSA]
RewriteRule ^admin/projects/edit/([0-9]+)/?$ admin/projects/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/projects/gallery/([0-9]+)/?$ admin/projects/gallery.php?id=$1 [L,QSA]
RewriteRule ^admin/project-categories/?$ admin/project_categories/index.php [L,QSA]
RewriteRule ^admin/experience/?$ admin/experience/index.php [L,QSA]
RewriteRule ^admin/experience/create/?$ admin/experience/create.php [L,QSA]
RewriteRule ^admin/experience/edit/([0-9]+)/?$ admin/experience/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/education/?$ admin/education/index.php [L,QSA]
RewriteRule ^admin/education/create/?$ admin/education/create.php [L,QSA]
RewriteRule ^admin/education/edit/([0-9]+)/?$ admin/education/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/testimonials/?$ admin/testimonials/index.php [L,QSA]
RewriteRule ^admin/testimonials/create/?$ admin/testimonials/create.php [L,QSA]
RewriteRule ^admin/testimonials/edit/([0-9]+)/?$ admin/testimonials/edit.php?id=$1 [L,QSA]
RewriteRule ^admin/messages/?$ admin/messages/index.php [L,QSA]
RewriteRule ^admin/messages/view/([0-9]+)/?$ admin/messages/view.php?id=$1 [L,QSA]
RewriteRule ^admin/blog/?$ admin/blog/index.php [L,QSA]
RewriteRule ^admin/blog/create/?$ admin/blog/create.php [L,QSA]
RewriteRule ^admin/blog/edit/([0-9]+)/?$ admin/blog/edit.php?id=$1 [L,QSA]

# Handle API routes (extensionless)
RewriteRule ^api/live-chat/init/?$ api/live-chat/init.php [L,QSA]
RewriteRule ^api/live-chat/send/?$ api/live-chat/send.php [L,QSA]
RewriteRule ^api/live-chat/messages/?$ api/live-chat/messages.php [L,QSA]
RewriteRule ^api/live-chat/read/?$ api/live-chat/read.php [L,QSA]
RewriteRule ^api/live-chat/close/?$ api/live-chat/close.php [L,QSA]

# Internally rewrite clean URLs to PHP files
# Check if file exists with .php extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Handle 404 for non-existent pages
ErrorDocument 404 /404.php

# Security Headers
<IfModule mod_headers.c>
    # Prevent XSS
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml
    <IfModule mod_setenvif.c>
        BrowserMatch ^Mozilla/4 gzip-only-text/html
        BrowserMatch ^Mozilla/4\.0[678] no-gzip
        BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    </IfModule>
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# Disable directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(env|log|sql|md|gitignore|gitattributes)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(config|includes)/.*\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files "database.sql">
    Order allow,deny
    Deny from all
</Files>

# Prevent access to hidden files
RedirectMatch 404 /\..*$

# PHP Settings (if allowed)
<IfModule mod_php.c>
    php_value upload_max_filesize 5M
    php_value post_max_size 10M
    php_value max_execution_time 60
    php_value max_input_time 60
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>