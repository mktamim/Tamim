# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================

# Application
APP_NAME="Traveleye Bangla"
APP_URL="https://traveleyebangla.com"
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka

# Database (REQUIRED - Get these from cPanel > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=traveleyeba_db
DB_USER=traveleyeba_traveleyeba
DB_PASS=your_strong_database_password_here

# Admin (Change after first login!)
ADMIN_EMAIL=admin@traveleyebangla.com
ADMIN_PASSWORD=ChangeMe123!

# Mail (Optional - for contact form)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@traveleyebangla.com
MAIL_FROM_NAME="Traveleye Bangla"

# File Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp